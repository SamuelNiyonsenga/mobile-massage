# Password for the CMS at /admin
ADMIN_PASSWORD=choose-a-long-password

# Random string used to sign the admin session cookie (openssl rand -hex 32)
SESSION_SECRET=replace-with-a-random-string

# Optional: where the CMS stores content and uploads (defaults to ./content)
# CMS_DATA_DIR=/var/data/mobile-massage

# Your public website address, e.g. https://www.mobilemassage.example
# Needed in production for canonical links, share previews and the sitemap.
# You can also set it in the CMS under Site settings, Search and social (that wins over this).
SITE_URL=
